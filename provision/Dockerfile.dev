# Base image for the Vagrant Docker provider (see ../Vagrantfile).
# Only provides what Vagrant needs to manage the container: an SSH server and a sudo-capable
# "vagrant" user. Everything else (.NET, PostgreSQL, database) is installed by bootstrap.sh so
# the setup stays readable step by step.
#
# NOT the production image of the API: that one is built later from a separate Dockerfile.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=Etc/UTC

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server sudo ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd \
 # Development-only user expected by Vagrant. The container's sshd is published on 127.0.0.1 only.
 && useradd --create-home --shell /bin/bash vagrant \
 && echo 'vagrant:vagrant' | chpasswd \
 && echo 'vagrant ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/vagrant \
 && chmod 0440 /etc/sudoers.d/vagrant \
 && printf 'PasswordAuthentication yes\nPermitRootLogin no\nUseDNS no\n' > /etc/ssh/sshd_config.d/vagrant.conf

EXPOSE 22

CMD ["/usr/sbin/sshd", "-D", "-e"]
