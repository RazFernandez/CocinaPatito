# =============================================================================
# Database credentials for the development container.
#
#   1. Copy this file to "db.env" in this same folder (provision/db.env).
#   2. Change the values below. db.env is ignored by git: it is never committed.
#   3. Run `vagrant up --provider=docker` (or `vagrant provision` if it already exists).
#
# Re-running the provisioning with new passwords updates them in PostgreSQL.
# Names: lowercase letters, digits and underscore only, starting with a letter or underscore.
# Passwords: anything except the "change-me" placeholders; at least 12 characters.
# =============================================================================

# Name of the database to create.
DB_NAME=splitbill

# Owner of the database and of every table. Used to run migrations (scripts in SQL/).
DB_OWNER_USER=splitbill_owner
DB_OWNER_PASSWORD=change-me-owner-password

# Password of "splitbill_app", the least-privilege role the API uses at runtime.
# The role NAME is fixed by SQL/0002_app_role.sql; only its password is set here.
DB_APP_PASSWORD=change-me-app-password
